# Simple KUMA — Nginx example
#
# Document root MUST be the public/ directory.
# Copy/adapt into your site config, then: nginx -t && systemctl reload nginx
#
# Apache users: you do not need this; public/.htaccess already rewrites click paths.
# PHP also recovers bare try_files→index.php for /km|/go|/c (see FrontControllerClickDispatch),
# but explicit rewrites below are preferred (API paths, less work in the admin front controller).

server {
    listen 80;
    server_name yourdomain.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name yourdomain.com;

    ssl_certificate     /path/to/certificate.crt;
    ssl_certificate_key /path/to/private.key;

    root /path/to/simplekuma/public;
    index index.php;

    # --- Click tracking (required for legacy /km/ and path-style /go/|/c/) ---
    # Nginx does not use .htaccess; without this, /km/... can hit index.php (login).
    location ~ ^/(km|go|c)/ {
        rewrite ^/(km|go|c)/([a-zA-Z0-9]+)/?$ /km.php?key=$2 last;
        rewrite ^/(km|go|c)/([a-zA-Z0-9]+)/(.+)$ /km.php?key=$2&slug=$3 last;
        return 404;
    }

    # REST API v1
    location ^~ /api/v1 {
        rewrite ^/api/v1(?:/(.*))?$ /api/v1/index.php?$query_string last;
    }

    # Google Ads Data Manager (.csv path required)
    location = /api/google-conversions.csv {
        rewrite ^ /api/google-conversions.php last;
    }

    location = /api/edge-click {
        rewrite ^ /api/edge-click.php last;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;  # adjust socket / php version
    }

    location ~ /\. {
        deny all;
    }

    # Deny paths outside public/ if the root was mis-set to project root
    location ~ ^/(config|storage|vendor|scripts|database)/ {
        deny all;
    }
}
